# Server only
BREVO_API_KEY=
FORM_SECRET=            # 32+ random characters: openssl rand -hex 32
CONTACT_INBOX=support@brandbasket.in
MAIL_SENDER=support@brandbasket.in   # must be a Brevo-verified sender
TEAMS_ENQUIRIES_WEBHOOK_URL=         # optional: a Teams Workflows webhook address; each enquiry is also posted to that channel
# Public
NEXT_PUBLIC_GTM_ID=                # e.g. GTM-ABC1234. Empty: no Tag Manager, no consent banner. Tools in the container are listed in lib/consent.ts
SITE_INDEXING=                     # set to "on" in Vercel production only when the owner approves launch
# The blog: where the CMS is, and the token this site sends it (the CMS's CMS_SITE_TOKEN has the same value).
CMS_URL=http://localhost:3140
CMS_SITE_TOKEN=                    # 32+ random characters: openssl rand -base64 32
# What the CMS calls this site with after a change (the CMS's REVALIDATE_SECRET has the same value).
REVALIDATE_SECRET=                 # 32+ random characters
# Where blog pictures load from. Leave empty in production (https://media.brandbasket.in).
BLOG_MEDIA_ORIGIN=
